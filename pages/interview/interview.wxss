.container {
  background: #f7f8fa;
  min-height: 100vh;
  padding: 0;
  width: 100% !important;
  box-sizing: border-box !important;
}


.page {
  width: 100%;
}


/* 核心修改：取消卡片左右外边距，和第一页布局对齐 */
.card {
  background: #fff;
  border-radius: 20rpx;
  margin: 30rpx 0 !important;  /* 左右margin改为0，仅保留上下间距 */
  padding: 25rpx;               /* 内部内边距同步缩小，贴近第一页风格 */
  width: auto !important;
  box-sizing: border-box !important;
}


.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  padding-left: 13rpx; /* 新增：和首页标题缩进对齐 */
}


.desc {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  padding-left: 13rpx;
}


.input {
  width: 100% !important;
  min-height: 200rpx;
  background: #f7f8fa;
  border-radius: 14rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
  border: none;
  box-sizing: border-box !important;
}


.btn {
  width: 100% !important;
  padding: 20rpx 0;
  border-radius: 50rpx;
  margin-bottom: 20rpx;
  color: #fbf9f9;
  font-size: 30rpx;
  border: none;
}


.blue {
  background: #1677ff;
}


.dark-gray {
  background: #9ca3af;
  color: #ffffff;
}


.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(255, 245, 235, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.loading-gif {
  width: 500rpx;
  height: 370rpx;
}
.loading-text {
  margin-top: 24rpx;
  font-size: 30rpx;
  color: #3c3c3c;
  font-weight: 450;
}


/* -------------------------- */
/* 最终优化文章样式 */
/* -------------------------- */
.article-item {
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #fafbfc;
  border-radius: 14rpx;
  transition: all 0.2s ease;
}
.article-item:active {
  background: #eef1f5;
  transform: scale(0.985);
}
.article-item:last-child {
  margin-bottom: 0;
}
.article-title {
  font-size: 29rpx;
  line-height: 1.55;
  margin-bottom: 8rpx;
}
/* 浅蓝标签 */
.article-tags {
  font-size: 24rpx;
  color: #8cb6e5; /* 浅蓝 */
}
