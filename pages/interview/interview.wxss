.container { background: #f7f8fa; min-height: 100vh; padding: 0; width: 100%; box-sizing: border-box; }
.page { width: 100%; }
.card { background: #fff; border-radius: 20rpx; margin: 30rpx 0; padding: 25rpx; box-sizing: border-box; }
.title { font-size: 36rpx; font-weight: 600; margin-bottom: 16rpx; padding-left: 13rpx; }
.desc { font-size: 28rpx; color: #333; margin-bottom: 16rpx; padding-left: 13rpx; }
.input { width: 100%; min-height: 200rpx; background: #f7f8fa; border-radius: 14rpx; padding: 24rpx; margin-bottom: 30rpx; box-sizing: border-box; }
.btn { width: 100%; padding: 20rpx 0; border-radius: 50rpx; margin-bottom: 20rpx; color: #fff; font-size: 30rpx; border: none; }
.blue { background: #1677ff; }
.dark-gray { background: #9ca3af; }
.loading-overlay { position: fixed; inset: 0; background: rgba(255,245,235,.95); display: flex; align-items: center; justify-content: center; z-index: 9999; }
.loading-box { display: flex; flex-direction: column; align-items: center; }
.loading-gif { width: 500rpx; height: 370rpx; }
.loading-text { margin-top: 24rpx; font-size: 30rpx; color: #3c3c3c; font-weight: 450; }
.article-item { margin-bottom: 24rpx; padding: 20rpx; background: #fafbfc; border-radius: 14rpx; }
.article-item:active { background: #eef1f5; transform: scale(.985); }
.article-title { font-size: 29rpx; line-height: 1.55; margin-bottom: 8rpx; }
.article-tags { font-size: 24rpx; color: #8cb6e5; }
