page {
  margin: 0;
  padding: 0;
  background: #f7f8fa;
  width: 100%;
  overflow-x: hidden;
}

.container {
  padding: 0 0 calc(100rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  width: 100%;
  box-sizing: border-box;
}

.banner {
  position: relative;
  width: 100%;
  height: 440rpx;
  padding: 0;
  background: transparent;
  overflow: hidden;
  text-align: center;
  color: #fff;
  transition: opacity 0.12s ease;
}

.banner--pressed {
  opacity: 0.88;
}

.banner-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.banner-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.7) 20%, rgba(0, 0, 0, 0.284) 40%, transparent 80%);
  z-index: 1;
}

.banner-content {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 32rpx;
  z-index: 2;
  color: #b0aaaa;
  pointer-events: none;
}

.banner-title {
  font-size: 42rpx;
  font-weight: bold;
  margin-bottom: 3rpx;
  color: rgba(245, 244, 242, 0.92);
}

.banner-subtitle {
  font-size: 26rpx;
  color: rgba(246, 242, 242, 0.92);
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  margin: 30rpx 0 16rpx;
  padding-left: 25rpx;
  text-align: left;
}

.input-full {
  width: calc(100% - 50rpx);
  min-height: 240rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  margin: 0 25rpx 26rpx;
  border: none;
}

.upload-btn {
  width: calc(100% - 50rpx);
  background: #1677ff;
  color: #fff;
  border-radius: 50rpx;
  padding: 20rpx 0;
  font-size: 30rpx;
  margin: 0 25rpx 10rpx;
  border: none;
}

.icon { margin-right: 10rpx; }

.tip {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin: 0 25rpx 30rpx;
}

.sample-box {
  margin-bottom: 50rpx;
  padding: 0 25rpx;
  width: 100%;
  box-sizing: border-box;
}

.sample-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.refresh-btn {
  width: auto;
  height: auto;
  background: transparent;
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 25rpx;
}

.refresh-icon { font-size: 60rpx; color: #666; }

.grid-row {
  display: flex;
  width: 100%;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.grid-item {
  width: 48%;
  height: 160rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.corner-mark {
  position: absolute;
  top: 0;
  right: 0;
  width: 50rpx;
  height: 50rpx;
  opacity: 0.3;
  z-index: 1;
}

.item-content { position: relative; z-index: 2; width: 100%; }
.line1 { font-size: 26rpx; font-weight: 500; color: #333; margin-bottom: 8rpx; line-height: 1.4; }
.line2 { font-size: 24rpx; color: #999; line-height: 1.3; }

.loading-mask {
  position: fixed;
  inset: 0;
  background: rgba(255, 245, 235, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-box { display: flex; flex-direction: column; align-items: center; }
.loading-img { width: 500rpx; height: 375rpx; object-fit: contain; display: block; }
.loading-text { margin-top: 24rpx; font-size: 30rpx; color: #333; font-weight: 450; }
