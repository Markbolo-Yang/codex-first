page { background-color: #f5f7fa; }
.container { padding: 20rpx; background-color: #f5f7fa; min-height: 100vh; box-sizing: border-box; }
.card { background: #fff; border-radius: 16rpx; padding: 30rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); box-sizing: border-box; }
.card-title { display: flex; align-items: center; justify-content: center; margin-bottom: 24rpx; text-align: center; }
.card-title text { font-size: 32rpx; font-weight: bold; color: #333; text-align: center; }
.desc-line { display: block; font-size: 28rpx; color: #444; line-height: 44rpx; margin-bottom: 12rpx; white-space: pre-wrap; }
.advantage-line { display: block; font-size: 28rpx; color: #1677ff; line-height: 44rpx; margin-bottom: 12rpx; }
.sub-card { margin-bottom: 28rpx; }
.sub-title { font-size: 29rpx; font-weight: 500; color: #333; margin-bottom: 16rpx; text-align: left; }
.improve-line { display: block; font-size: 28rpx; color: #f57c00; line-height: 44rpx; margin-bottom: 10rpx; }
.project-item { margin-bottom: 20rpx; padding-left: 10rpx; }
.project-name { font-size: 28rpx; font-weight: 500; color: #333; margin-bottom: 10rpx; }
.compare-box { margin-bottom: 30rpx; }
.original { background: #f2f3f5; color: #999; padding: 20rpx; border-radius: 12rpx; font-size: 26rpx; margin-bottom: 16rpx; }
.optimize { background: #e8f3ff; padding: 24rpx; border-radius: 12rpx; }
.optimize text { font-size: 28rpx; color: #1677ff; line-height: 42rpx; display: block; white-space: pre-wrap; }
.copy-btn { margin-top: 16rpx; font-size: 24rpx; color: #fff; background: #1677ff; padding: 8rpx 20rpx; border-radius: 8rpx; display: inline-block; }
.project-label { font-size: 27rpx; font-weight: 500; color: #1677ff; margin-bottom: 12rpx; }
.bottom-btn { background: #1677ff; color: #fff; text-align: center; font-size: 30rpx; padding: 28rpx; border-radius: 16rpx; margin: 40rpx 0 60rpx; font-weight: 500; width: 100%; box-sizing: border-box; }
