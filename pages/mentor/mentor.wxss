.page {
  background: #f7f8fa;
  min-height: 100vh;
}

.banner { width: 100%; }
.banner-swiper { width: 100%; height: 320rpx; }
.banner-item { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
.banner-img { width: 100%; height: 100%; display: block; }

.form-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.form-title { font-size: 38rpx; font-weight: 600; color: #222; margin-bottom: 18rpx; }
.mentor-scroll-wrap { width: 100%; height: 200rpx; overflow: hidden; margin-bottom: 30rpx; }
.mentor-scroll-box { height: 100%; display: flex; align-items: center; transition: transform 0.6s ease; }
.mentor-item { width: 120rpx; height: 170rpx; margin-left: -8rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; }

.avatar-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  position: relative;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.avatar-img { width: 100%; height: 100%; }
.glass-info { position: absolute; left: 0; bottom: 0; width: 100%; height: 48%; background: rgba(8, 7, 7, 0.143); backdrop-filter: blur(6px); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.mentor-job { font-size: 20rpx; color: #fff; font-weight: 500; text-shadow: 0 0 4rpx rgba(0, 0, 0, 0.3); }
.mentor-company { font-size: 17rpx; color: #fffefe; }
.mentor-nick { margin-top: 10rpx; font-size: 25rpx; color: #a9a8a8; font-weight: bold; }

.picker-field { display: flex; justify-content: space-between; align-items: center; background: #f7f8fa; border-radius: 12rpx; padding: 28rpx; font-size: 30rpx; color: #333; margin-bottom: 30rpx; }
.arrow { font-size: 24rpx; color: #999; }
.textarea-field { width: 100%; min-height: 200rpx; background: #f7f8fa; border-radius: 12rpx; padding: 28rpx; font-size: 28rpx; line-height: 1.6; margin-bottom: 40rpx; box-sizing: border-box; }
.submit-btn { width: 100%; background: #f28522; color: #fff; border-radius: 50rpx; padding: 22rpx 0; font-size: 32rpx; font-weight: 500; box-shadow: 0 6rpx 20rpx rgba(242, 133, 34, 0.25); }

.bottom-tip {
  position: fixed;
  top: calc(50% + 110rpx);
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.75);
  color: #fff;
  font-size: 26rpx;
  padding: 14rpx 28rpx;
  border-radius: 10rpx;
  z-index: 99999;
  max-width: 80%;
  text-align: center;
}
