<view class="admin-page">
  <view class="toolbar">
    <view>
      <view class="title">用户咨询</view>
      <view class="subtitle">仅限已配置的客服管理员访问</view>
    </view>
    <picker mode="selector" range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="onStatusChange">
      <view class="status-picker">{{statusOptions[statusIndex].label}}⌄</view>
    </picker>
  </view>

  <view class="error-card" wx:if="{{errorMessage}}">
    <text>{{errorMessage}}</text>
    <text class="retry" bindtap="loadConsults" data-reset="true">重新加载</text>
  </view>

  <view class="empty" wx:if="{{!loading && !errorMessage && consultList.length === 0}}">暂无咨询记录</view>

  <view class="consult-card" wx:for="{{consultList}}" wx:key="_id">
    <view class="card-head">
      <text class="category">{{item.consultType || '未分类'}}</text>
      <text class="status status--{{item.status}}">{{item.status === 'processed' ? '已处理' : '待处理'}}</text>
    </view>
    <view class="content">{{item.content || '未填写具体诉求'}}</view>
    <view class="meta-row"><text class="meta-label">提交时间</text><text>{{item.createTime || '-'}}</text></view>
    <view class="meta-row"><text class="meta-label">用户 OpenID</text><text class="openid" selectable>{{item._openid || '-'}}</text></view>
    <textarea
      class="remark"
      placeholder="填写客服备注（最多500字）"
      maxlength="500"
      value="{{item.remark}}"
      data-index="{{index}}"
      bindinput="onRemarkInput"
    ></textarea>
    <button
      wx:if="{{item.status !== 'processed'}}"
      class="process-button"
      loading="{{item._submitting}}"
      disabled="{{item._submitting}}"
      data-index="{{index}}"
      bindtap="markProcessed"
    >标记已处理</button>
  </view>

  <view class="loading" wx:if="{{loading}}">正在加载…</view>
  <view class="list-end" wx:if="{{!loading && consultList.length > 0 && !hasMore}}">已经到底了</view>
</view>
