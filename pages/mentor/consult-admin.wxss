page {
  background: #f5f7fa;
  color: #1f2937;
}

.admin-page { padding: 28rpx; }
.toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.title { font-size: 40rpx; font-weight: 700; }
.subtitle { margin-top: 6rpx; color: #8a94a3; font-size: 22rpx; }
.status-picker { padding: 16rpx 22rpx; border: 1rpx solid #dce3ec; border-radius: 12rpx; background: #fff; color: #1677ff; font-size: 26rpx; }
.consult-card, .error-card { margin-bottom: 22rpx; padding: 26rpx; border-radius: 18rpx; background: #fff; box-shadow: 0 5rpx 20rpx rgba(31, 41, 55, 0.06); }
.card-head { display: flex; align-items: center; justify-content: space-between; }
.category { font-size: 30rpx; font-weight: 600; }
.status { padding: 6rpx 14rpx; border-radius: 18rpx; font-size: 22rpx; }
.status--pending { background: #fff1e8; color: #f26a21; }
.status--processed { background: #e9f8ef; color: #159447; }
.content { margin: 22rpx 0; padding: 20rpx; border-radius: 12rpx; background: #f7f8fa; font-size: 28rpx; line-height: 1.6; white-space: pre-wrap; }
.meta-row { display: flex; margin-top: 12rpx; color: #5f6978; font-size: 24rpx; line-height: 1.5; }
.meta-label { width: 130rpx; flex-shrink: 0; color: #9aa3af; }
.openid { flex: 1; word-break: break-all; }
.remark { box-sizing: border-box; width: 100%; min-height: 120rpx; margin-top: 22rpx; padding: 18rpx; border-radius: 12rpx; background: #f7f8fa; font-size: 26rpx; }
.process-button { margin-top: 20rpx; border-radius: 40rpx; background: #1677ff; color: #fff; font-size: 28rpx; }
.process-button::after { border: 0; }
.empty, .loading, .list-end { padding: 80rpx 0; text-align: center; color: #9aa3af; font-size: 26rpx; }
.error-card { display: flex; justify-content: space-between; color: #d14343; font-size: 26rpx; }
.retry { color: #1677ff; }
