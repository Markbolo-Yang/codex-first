page {
  background: #f5f7fa;
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  user-select: text;
  -webkit-user-select: text;
}

.wrap {
  padding: 20rpx;
  padding-bottom: 100rpx;
}

.block {
  background: #fff;
  border-radius: 20rpx;
  padding: 34rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
  position: relative;
  overflow: hidden;
}


.block-title {
  font-size: 36rpx;
  font-weight: bold;
  margin: 0 0 26rpx;
  color: #1677ff;
  line-height: 1.3;
}

.sub-title {
  font-size: 32rpx;
  font-weight: 500;
  margin: 28rpx 0 16rpx;
}

.small-tit {
  margin: 20rpx 0 10rpx;
  font-weight: 500;
  font-size: 29rpx;
}

.success-tit {
  color: #00b42a;
  margin-top: 26rpx;
}


.info-line,
.info-desc {
  display: block;
  margin-bottom: 10rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.match-tip {
  display: block;
  margin-top: 14rpx;
  color: #444;
  line-height: 1.7;
  white-space: pre-wrap;
}


.item-box {
  margin-bottom: 28rpx;
}

.item-tit {
  font-weight: 500;
  margin-bottom: 14rpx;
  font-size: 30rpx;
  line-height: 1.4;
}

.item-desc {
  display: block;
  margin-bottom: 8rpx;
  line-height: 1.7;
  font-size: 28rpx;
  white-space: pre-wrap;
}


.orange-text {
  color: #ff7d00;
  font-weight: 500;
}

.gray-bg {
  background: #f7f7f7;
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  margin: 10rpx 0;
}


/* 示范内容 放大到和正文一致 28rpx */
.demo-content {
  display: block;
  color: #666;
  font-size: 28rpx;
  line-height: 1.8;
  margin: 12rpx 0;
  white-space: pre-wrap;
}

.demo-collapsed {
  max-height: 100rpx;
  overflow: hidden;
}

.demo-expanded {
  max-height: none;
}

.fold-btn {
  font-size: 24rpx;
  color: #1677ff;
  margin-top: 8rpx;
  display: flex;
  align-items: center;
}


.q-box {
  margin-bottom: 28rpx;
}

.q-tit {
  font-weight: 500;
  margin-bottom: 12rpx;
  font-size: 30rpx;
  line-height: 1.4;
}

/* 答题方向 字号放大统一 28rpx */
.q-dir {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
  line-height: 1.7;
}


.generating-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #777;
  padding: 24rpx;
}

.generating-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #1677ff;
  margin-right: 16rpx;
  animation: generating-pulse 1.2s infinite;
}

@keyframes generating-pulse {
  0%,
  100% {
    opacity: 0.25;
    transform: scale(0.8);
  }

  50% {
    opacity: 1;
    transform: scale(1.15);
  }
}


.bottom-btn {
  margin-top: 40rpx;
}

.bottom-btn button {
  background: #1677ff;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 22rpx 0;
  font-weight: 500;
}
