<view class="wrap">
  <!-- 板块一：个人面试定位 -->
  <view wx:if="{{report.profileOverview || report.keyExaminePoint.length || report.matchAdvice}}" class="block">
    <view class="block-title">📌 我的面试定位</view>
    <text selectable class="info-line">{{report.profileOverview}}</text>

    <view wx:if="{{report.keyExaminePoint.length}}" class="sub-title">🎯 岗位核心考察点</view>
    <view
      class="info-desc"
      wx:for="{{report.keyExaminePoint}}"
      wx:key="index"
    >
      • {{item}}
    </view>

    <text selectable class="match-tip">{{report.matchAdvice}}</text>
  </view>

  <!-- 板块二：面试表达高分建议 -->
  <view wx:if="{{report.interviewSkillGuide.selfIntro || report.interviewSkillGuide.projectRule || report.interviewSkillGuide.interviewHabit}}" class="block">
    <view class="block-title">💬 面试表达高分指南</view>

    <view wx:if="{{report.interviewSkillGuide.selfIntro}}" class="item-box">
      <view class="item-tit">1. 🎤 自我介绍</view>
      <text selectable class="item-desc">{{report.interviewSkillGuide.selfIntro}}</text>
    </view>

    <view wx:if="{{report.interviewSkillGuide.projectRule}}" class="item-box">
      <view class="item-tit">2. 📊 项目作答公式</view>
      <text selectable class="item-desc">{{report.interviewSkillGuide.projectRule}}</text>
    </view>

    <view wx:if="{{report.interviewSkillGuide.interviewHabit}}" class="item-box">
      <view class="item-tit">3. 🎧 面试习惯与复盘</view>
      <text selectable class="item-desc">{{report.interviewSkillGuide.interviewHabit}}</text>
    </view>
  </view>

  <!-- 板块三：岗位高频预判问题 -->
  <view wx:if="{{report.questionList.length}}" class="block">
    <view class="block-title">❓ 岗位高频预判问题</view>

    <view
      class="q-box"
      wx:for="{{report.questionList}}"
      wx:key="index"
    >
      <view class="q-tit">{{index + 1}}. {{item.title}}</view>
      <view wx:if="{{item.thinking}}" class="q-dir gray-bg">答题思路：{{item.thinking}}</view>

      <text
        wx:if="{{item.sampleAnswer}}"
        selectable
        class="demo-content {{folds[index] ? 'demo-expanded' : 'demo-collapsed'}}"
      >{{item.sampleAnswer}}</text>
      <view
        wx:if="{{item.sampleAnswer}}"
        class="fold-btn"
        data-index="{{index}}"
        bindtap="toggleFold"
      >
        {{folds[index] ? '▼ 收起' : '▶ 查看完整示范'}}
      </view>
    </view>
  </view>

  <view wx:if="{{generating}}" class="generating-indicator">
    <view class="generating-dot"></view>
    <view>报告持续生成中...</view>
  </view>

  <!-- 底部操作区 -->
  <view wx:if="{{displayComplete}}" class="bottom-btn">
    <button bindtap="goMentor">🚀 转真人导师1V1面试咨询</button>
  </view>
</view>
