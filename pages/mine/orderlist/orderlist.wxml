<view class="page-wrap">
  <scroll-view scroll-y class="list-wrap" bindscrolltolower="onOrderListLower" lower-threshold="80">
    <view class="empty-box" wx:if="{{!isLoading && orderList.length === 0}}">
      <view class="empty-text">暂无消费记录</view>
    </view>

    <view class="order-item" wx:for="{{orderList}}" wx:key="orderNo">
      <view class="order-top">
        <text class="order-name">{{item.productName}}</text>
        <text class="order-price">¥{{item.totalFee}}</text>
      </view>
      <view class="order-bottom">
        <text class="order-time">{{item.createTime}}</text>
        <text class="order-status {{item.payStatus === 1 ? 'status-done' : 'status-wait'}}">
          {{item.statusText}}
        </text>
      </view>
    </view>

    <view class="list-tip" wx:if="{{isLoading}}">加载中...</view>
    <view class="list-tip" wx:if="{{!isLoading && orderList.length > 0 && !hasMore}}">没有更多订单了</view>
  </scroll-view>
</view>
