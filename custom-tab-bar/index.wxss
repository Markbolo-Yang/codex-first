.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  display: flex;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1rpx solid #e7e7e7;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.03);
}

.tab-bar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.tab-bar__icon-wrap {
  position: relative;
  width: 54rpx;
  height: 54rpx;
}

.tab-bar__icon {
  display: block;
  width: 54rpx;
  height: 54rpx;
}

.tab-bar__hot {
  position: absolute;
  top: -15rpx;
  left: 43rpx;
  min-width: 42rpx;
  height: 26rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border: 2rpx solid #fff;
  border-radius: 15rpx 15rpx 15rpx 5rpx;
  background: linear-gradient(135deg, #ff5b42 0%, #f5222d 55%, #d90920 100%);
  box-shadow: 0 4rpx 10rpx rgba(245, 34, 45, 0.32);
  color: #fff;
  font-size: 16rpx;
  font-weight: 700;
  line-height: 22rpx;
  letter-spacing: 1rpx;
  text-align: center;
  transform: rotate(3deg);
  transform-origin: left bottom;
  pointer-events: none;
}

.tab-bar__label {
  margin-top: 2rpx;
  font-size: 22rpx;
  line-height: 28rpx;
  white-space: nowrap;
}
