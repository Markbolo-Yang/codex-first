<view class="tab-bar">
  <view
    class="tab-bar__item"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-bar__icon-wrap">
      <image class="tab-bar__icon" src="{{selected === index ? item.selectedIconPath : item.iconPath}}"></image>
      <view wx:if="{{item.hot}}" class="tab-bar__hot">HOT</view>
    </view>
    <view class="tab-bar__label" style="color: {{selected === index ? selectedColor : color}}">{{item.text}}</view>
  </view>
</view>
